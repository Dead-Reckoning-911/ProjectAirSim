// Maritime intercept flown by Betaflight SITL.
// spawn-objects restored: without the OceanSlab the airframe falls past the
// deck onto Blocks terrain and wedges in the geometry. The load timeout this
// was removed for turned out to be host memory pressure, not the scene.
{
  "id": "SceneMaritimeBetaflight",
  "actors": [
    {
      "type": "robot",
      "name": "Drone1",
      "origin": {
        "xyz": "0.0 0.0 -54.0",
        "rpy-deg": "0 0 0"
      },
      "robot-config": "robot_quadrotor_betaflight.jsonc"
    }
  ],
  "clock": {
    "type": "steppable",
    "step-ns": 3000000,
    "real-time-update-rate": 3000000,
    "pause-on-start": false
  },
  "home-geo-point": {
    "latitude": 47.641468,
    "longitude": -122.140165,
    "altitude": 122.0
  },
  "segmentation": {
    "initialize-ids": true,
    "ignore-existing": false,
    "use-owner-name": true
  },
  "scene-type": "UnrealNative",
  "spawn-objects": {
    "sim-packaged": [
      {
        "name": "OceanSlab",
        "asset-path": "1M_Cube",
        "scale": "2500 2500 2",
        "physics-enabled": false,
        "origin": {
          "xyz": "0 0 -51.0",
          "rpy-deg": "0 0 0"
        }
      },
      {
        "name": "CrimsonDawn",
        "asset-path": "BasicLandingPad",
        "scale": "14 28 1.2",
        "physics-enabled": false,
        "origin": {
          "xyz": "0 0 -51.2",
          "rpy-deg": "0 0 0"
        }
      }
    ]
  }
}
