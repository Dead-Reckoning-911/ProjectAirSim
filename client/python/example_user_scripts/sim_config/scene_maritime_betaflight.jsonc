// Maritime intercept flown by Betaflight SITL.
// No spawn-objects: that block forces the steppable clock to pause on load
// and makes the first load after an Unreal start blow get_topic_info's 60 s
// timeout. The pipeline spawns the ocean slab, Crimson Dawn and the boats at
// runtime instead (_paint_ocean / _spawn_boat).
{
  "id": "SceneMaritimeBetaflight",
  "actors": [
    {
      "type": "robot",
      "name": "Drone1",
      "origin": {
        "xyz": "0.0 0.0 -54.0",
        "rpy-deg": "0 0 0"
      },
      "robot-config": "robot_quadrotor_betaflight.jsonc"
    }
  ],
  "clock": {
    "type": "steppable",
    "step-ns": 3000000,
    "real-time-update-rate": 3000000,
    "pause-on-start": false
  },
  "home-geo-point": {
    "latitude": 47.641468,
    "longitude": -122.140165,
    "altitude": 122.0
  },
  "segmentation": {
    "initialize-ids": true,
    "ignore-existing": false,
    "use-owner-name": true
  },
  "scene-type": "UnrealNative"
}
