  ],
  // Betaflight SITL is the flight controller. ProjectAirSim contributes physics
  // and rendering only: the sim's own stabiliser is replaced by a pass-through
  // whose rotor outputs are written by the bridge from Betaflight's motor
  // demands. Actuators are addressed by NAME via set_control_signals, so
  // Betaflight's quad-X numbering (M1=RR, M2=FR, M3=RL, M4=FL) is mapped in the
  // bridge rather than depending on this order.
  "controller": {
    "id": "Betaflight_Bridge",
    // matlab-controller-api is a generic external-controller bridge despite the
    // name: it runs INSIDE the physics step and blocks on an NNG socket, so the
    // loop closes at the sim step rate instead of the ~4 Hz a client-side RPC
    // round-trip allows. Betaflight needs 50 Hz minimum.
    "type": "matlab-controller-api",
    "matlab-controller-api-settings": {
      "control-connection": {
        "ip": "127.0.0.1",
        "port": 8998
      },
      "actuator-order": [
        {
          "id": "Prop_FR_actuator",
          "initial-value": 0.0
        },
        {
          "id": "Prop_RL_actuator",
          "initial-value": 0.0
        },
        {
          "id": "Prop_FL_actuator",
          "initial-value": 0.0
        },
        {
          "id": "Prop_RR_actuator",
          "initial-value": 0.0
        }
      ]
    }
  },
  "actuators": [
    {
      "name": "Prop_FL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "origin": {
        "xyz": "0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_FR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      "origin": {
        "xyz": "0.253 0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_RL_actuator",
